{
  "name": "persian-book-translator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --platform=node --format=esm --target=node18 --bundle --packages=external --outfile=dist/server.js",
    "build": "vite build && npm run build:server",
    "preview": "vite preview",
    "start": "node server.ts",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist', {recursive:true, force:true}); try{fs.unlinkSync('server.js')}catch(e){}\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/compression": "^1.8.1",
    "@types/jszip": "^3.4.1",
    "@types/pdf-parse": "^1.1.5",
    "@vitejs/plugin-react": "^6.1.1",
    "compression": "^1.8.2",
    "docx": "^9.13.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html-to-text": "^10.0.1",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.13.0",
    "motion": "^12.23.24",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
